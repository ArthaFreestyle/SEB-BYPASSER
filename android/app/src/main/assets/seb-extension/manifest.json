{
    "manifest_version": 2,
    "name": "SEB Bypass",
    "version": "1.0.1",
    "description": "Built-in GeckoView WebExtension to inject Safe Exam Browser headers",
    "browser_specific_settings": {
        "gecko": {
            "id": "seb-bypass@overlord08x.dev"
        }
    },
    "permissions": [
        "geckoViewAddons",
        "nativeMessaging",
        "webRequest",
        "webRequestBlocking",
        "<all_urls>"
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    }
}
