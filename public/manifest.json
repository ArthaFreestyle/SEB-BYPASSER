{
    "manifest_version": 3,
    "name": "SEB",
    "version": "1.0",
    "permissions": [
        "debugger",
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "assets/background.js",
        "type": "module"
    },
    "action": {
        "default_title": "SEB configuration"
    }
}
